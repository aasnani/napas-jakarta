{
  "name": "web",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "build": "npm run build:eve && next build",
    "dev": "next dev",
    "dev:api": "cd .. && uv run --no-sync python -m uvicorn app.api:app --host 127.0.0.1 --port 8502",
    "eval": "eve eval",
    "start": "next start",
    "test": "node --experimental-strip-types --test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.82",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@shikijs/core": "3.23.0",
    "@shikijs/engine-javascript": "3.23.0",
    "@shikijs/engine-oniguruma": "3.23.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "ai": "^7.0.105",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eve": "^0.67.0",
    "just-bash": "3.1.0",
    "lucide-react": "1.16.0",
    "maplibre-gl": "^6.11.2",
    "motion": "12.40.0",
    "nanoid": "5.1.16",
    "next": "16.3.4",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "3.23.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
